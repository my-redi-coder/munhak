{
 "title": "8회말 응원",
 "lines": [
  {
   "t": 20.53,
   "e": 27.01,
   "text": "어쩌다 한 번 오는 저 배는"
  },
  {
   "t": 27.01,
   "e": 34.54,
   "text": "무슨 사연 싣고 오길래"
  },
  {
   "t": 34.54,
   "e": 41.32,
   "text": "오는 사람, 가는 사람"
  },
  {
   "t": 41.32,
   "e": 49.42,
   "text": "마음마다 설레게 하나"
  },
  {
   "t": 49.42,
   "e": 56.43,
   "text": "부두에 꿈을 두고 떠나는 배야"
  },
  {
   "t": 56.43,
   "e": 62.39,
   "text": "갈매기 우는 마음 너는 알겠지"
  },
  {
   "t": 61.99,
   "e": 73.49,
   "text": "말해다오, 말해다오"
  },
  {
   "t": 71.49,
   "e": 77.3,
   "text": "여난부두 떠나는 배야"
  },
  {
   "t": 85.3,
   "e": 92.25,
   "text": "바람이 불면 파도가 울고"
  },
  {
   "t": 92.25,
   "e": 98.66,
   "text": "배 떠나면 나도 운단다"
  },
  {
   "t": 98.66,
   "e": 108.31,
   "text": "안개 속에 가물가물"
  },
  {
   "t": 106.31,
   "e": 114.31,
   "text": "정든 사람 손을 흔드네"
  },
  {
   "t": 114.31,
   "e": 121.31,
   "text": "저무는 여난부두 외로운 불빛"
  },
  {
   "t": 121.31,
   "e": 129.9,
   "text": "홀로 선 이 마음을 달래주는데"
  },
  {
   "t": 128.2,
   "e": 137.74,
   "text": "말해다오, 말해다오"
  },
  {
   "t": 136.74,
   "e": 143.16,
   "text": "여난부두 떠나는 배야"
  }
 ]
}