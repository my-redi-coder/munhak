 "lines": [
  {
   "t": 13.03,
   "e": 15.93,
   "text": "나의 뜨거운 마음을 (란다스!)"
  },
  {
   "t": 15.93,
   "e": 19.12,
   "text": "불 같은 나의 마음을 (란다스!)"
  },
  {
   "t": 19.12,
   "e": 21.99,
   "text": "다시 태울 순 없을까 (란다스!)"
  },
  {
   "t": 21.99,
   "e": 25.15,
   "text": "헤어지기는 정말 싫어 (란다스!)"
  },
  {
   "t": 25.15,
   "e": 28.13,
   "text": "이제라도 살며시"
  },
  {
   "t": 28.13,
   "e": 31.34,
   "text": "(나나나나나나나나 나나나나나나나나)"
  },
  {
   "t": 31.34,
   "e": 34.56,
   "text": "나를 두고 간다면"
  },
  {
   "t": 34.56,
   "e": 38.63,
   "text": "내 마음 너무나 아쉬워~ (와~)"
  },
  {
   "t": 38.63,
   "e": 41.76,
   "text": "날마다 만 (인!) 나서 하는 (천!)말"
  },
  {
   "t": 41.76,
   "e": 44.94,
   "text": "모두가 그 (란다스!) 렇고 그런 얘기 (와~)"
  },
  {
   "t": 44.94,
   "e": 47.93,
   "text": "하루 또 하 (인!) 루 지나면 (천!)"
  },
  {
   "t": 47.93,
   "e": 51.35,
   "text": "마음이 너 (란다스!) 무 답답해 (와~)"
  },
  {
   "t": 51.35,
   "e": 54.26,
   "text": "돌아서 말 (인!) 없이 갈 때 (천!) 면"
  },
